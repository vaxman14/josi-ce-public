# Josi CE configuration. Copy to .env and edit.
#
# NO SECRETS BELONG IN THIS FILE. The master key and the database password are
# generated by scripts/install.sh into ./secrets/ and mounted as Docker secrets.
# Nothing here is confidential.

# --------------------------------------------------------------------- domain
# The hostname Josi is served on. With a real domain, bundled Caddy obtains and
# renews a certificate automatically.
#
# EMPTY BY DEFAULT, and that is the safe default rather than an omission.
# A value here turns on automatic HTTPS for that name. `localhost` used to be
# the default and made Caddy redirect every plain-HTTP request to a port it had
# dropped, which broke the LAN path entirely.
JOSI_DOMAIN=
# Where browsers reach Josi. With a domain set this is derived; on a LAN set it
# to this server's address and port.
JOSI_APP_URL=http://localhost
# Optional: enables certificate-expiry notices from Let's Encrypt.
JOSI_ACME_EMAIL=

# Normally leave empty: Josi follows JOSI_APP_URL (secure on HTTPS, usable on
# LAN HTTP). Set true/false only as an advanced override.
JOSI_COOKIE_SECURE=

# Native Sign in with Apple audience. Leave empty to disable. The official
# Josi CE iPhone/iPad app uses com.socalreceptionist.josice.
APPLE_NATIVE_CLIENT_ID=

# Host ports for the bundled proxy. Change if 80/443 are already taken.
JOSI_HTTP_PORT=80
JOSI_HTTPS_PORT=443
# Direct app port when an existing reverse proxy is selected.
JOSI_WEB_PORT=8081

# Written by the browser installer after its review step. Manual Compose users
# leave these empty and complete Address and HTTPS in the application wizard.
JOSI_ACCESS_MODE=
JOSI_INSTALLER_CONFIGURED=
# SHA-256 only. The browser installer never stores the raw setup handoff token.
JOSI_SETUP_TOKEN_SHA256=

# --------------------------------------------------------------------- database
POSTGRES_DB=josi
POSTGRES_USER=josi
# The password is NOT here. It lives in ./secrets/db_password.

# ---------------------------------------------------------------------- images
# Where released images are pulled from. Only relevant to the published
# installation (docker-compose.release.yml); a source build ignores it.
JOSI_REGISTRY=docker.io/romanvaxman
JOSI_IMAGE=josi-ce
# The release to run. `local` is the tag a source build produces, so it is the
# right default for docker-compose.yml and the wrong one for the published file
# — which carries its own concrete default and never floats on `latest`. Set
# this to pin a version or to move to a newer one.
JOSI_TAG=local
JOSI_VOICE_SOCKET_DIR=./voice-helper-socket
JOSI_MAINTENANCE_SOCKET_DIR=./maintenance-helper-socket

# Set to 1 only after adding one or more explicit host bind mounts under
# /data/roots in both the web and worker services. The CLI verifies the
# resolved running mounts; it does not trust a transient host shell path.
JOSI_WORKSPACE_ENABLED=0
JOSI_WORKSPACE_MODE=ro

# Stack UIs may store the compose definition separately from its persistent
# data directory. In that case set these three values to absolute host paths.
# The one-shot installer and normal Docker Compose path should leave them blank.
JOSI_MASTER_KEY_FILE=
JOSI_DB_PASSWORD_FILE=
JOSI_CADDYFILE=

# ------------------------------------------------------- optional components
# Neither is started unless its profile is selected:
#   docker compose --profile ocr up -d
#   docker compose --profile clamav up -d
# Without the profile, Compose creates no container and pulls no image.
JOSI_OCR_CPUS=1.0
JOSI_OCR_MEMORY=512m
JOSI_CLAMAV_MEMORY=1500m
